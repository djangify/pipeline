DEBUG=True
# Leave SECRET_KEY blank and Pipeline generates a random one the first time it
# runs and keeps it in the data folder. To set your own:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
PRIMARY_DOMAIN=http://127.0.0.1:8000
FOLLOWUP_REMINDER_TO=
DEFAULT_FROM_EMAIL=pipeline@example.com

# The first login. Normally leave both out: Pipeline creates the login for you
# with a random password, saved in first_login.txt in the data folder. Set
# DEFAULT_USER_EMAIL to change the login name. Set DEFAULT_USER_PASSWORD only if
# you want to choose the first password yourself instead of getting a random one.
# DEFAULT_USER_EMAIL=owner@example.com
# DEFAULT_USER_PASSWORD=

# Follow-up reminder emails (python manage.py followup_reminders). Without these,
# the reminder is printed to the terminal instead of sent.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
