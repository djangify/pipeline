DEBUG=True
# Leave SECRET_KEY blank and Pipeline generates a random one the first time it
# runs and keeps it in the data folder. To set your own:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
PRIMARY_DOMAIN=http://127.0.0.1:8000
FOLLOWUP_REMINDER_TO=
DEFAULT_FROM_EMAIL=pipeline@example.com

# Optional. Normally leave these out: on first launch Pipeline shows a setup
# page where you choose your own email and password. Set BOTH only if you want a
# hands-off install to create that first login for you (then change the password).
# DEFAULT_USER_EMAIL=
# DEFAULT_USER_PASSWORD=
